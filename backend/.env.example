# Copie para .env em desenvolvimento local.
# Em producao (Railway) essas variaveis sao definidas no painel.

# Banco de dados. Local usa SQLite; no Railway use a variavel DATABASE_URL do Postgres.
DATABASE_URL=sqlite:///./volante.db

# Chave secreta do JWT — GERE UMA FORTE em producao (ex: openssl rand -hex 32)
JWT_SECRET=troque-esta-chave-em-producao

# Origens permitidas no CORS (dev). Em prod, como servimos junto, nao precisa.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
